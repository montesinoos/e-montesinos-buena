---
import Base from "../layouts/Base.astro";
import Pie from "../components/Pie.astro";
import { sedes } from "../data/montesinos.js";
---

<Base
  titulo="Contacto — Ebanistería Montesinos"
  desc="Presupuesto orientativo. Sabadell, Madrid, Bilbao y Londres. Escríbenos y contestamos enseguida."
  ruta="/contacto"
>
  <main id="principal" class="pagina sc-wrap">
    <div class="titular">
      <p class="eti">Contacto</p>
      <h1>Presupuesto orientativo.</h1>
      <p>
        Cuéntanos qué hay que resolver, o simplemente pregunta lo que necesites
        saber. Contestamos enseguida.
      </p>
    </div>

    <div class="dos" style="align-items:start; gap: var(--sc-9);">
      <form class="form" id="form-contacto" novalidate>
        <div class="campo">
          <label for="nombre">Nombre y apellido</label>
          <input id="nombre" name="nombre" type="text" autocomplete="name" required />
        </div>
        <div class="campo">
          <label for="email">Correo electrónico</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="campo">
          <label for="localidad">Localidad</label>
          <input id="localidad" name="localidad" type="text" autocomplete="address-level2" />
        </div>
        <div class="campo">
          <label for="asunto">Asunto</label>
          <input id="asunto" name="asunto" type="text" />
        </div>
        <div class="campo">
          <label for="mensaje">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="5"></textarea>
        </div>
        <div class="opcion">
          <input id="catalogo" name="catalogo" type="checkbox" />
          <label for="catalogo">Quiero recibir el catálogo</label>
        </div>
        <button class="enviar" type="submit">Enviar</button>
        <p class="recado" id="recado" role="status" aria-live="polite"></p>
      </form>

      <div>
        <h2 class="paso__n" style="color:var(--sc-accent); margin-bottom:var(--sc-4);">
          CUATRO SITIOS DONDE VISITARNOS
        </h2>
        <ul class="pasos" style="list-style:none; padding:0;">
          {sedes.map((s) => (
            <li class="paso" style="grid-template-columns: 1fr;">
              <span class="paso__n" style="margin-bottom:0.4rem;">{s.pais}</span>
              <h3>{s.ciudad} <span style="font-family:var(--sc-font-mono);font-size:var(--sc-t-xs);color:var(--sc-ink-soft);text-transform:uppercase;letter-spacing:0.06em;">· {s.rol}</span></h3>
              <p>
                {s.dir}<br />{s.cp}
                {s.tel && (<><br /><a href={`tel:${s.telHref}`}>{s.tel}</a></>)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <Pie />
  </main>
</Base>
