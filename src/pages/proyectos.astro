---
import fs from "node:fs";
import Base from "../layouts/Base.astro";
import Pie from "../components/Pie.astro";
import { proyectos, sectores } from "../data/montesinos.js";

const nombreSector = (id) => sectores.find((s) => s.id === id)?.nombre ?? id;

// Qué fotos tienen copia de móvil. Se mira la carpeta en tiempo de compilación
// en vez de mantener una lista a mano: la lista se olvidaría en cuanto entrara
// una obra nueva, y un srcset que apunta a un archivo inexistente da un 404 en
// silencio y deja el hueco en blanco. Las fotos que ya venían por debajo de
// 1100 px no tienen `-m` porque no lo necesitan.
const conMovil = new Set(
  fs
    .readdirSync("public/proyectos-web")
    .filter((f) => f.endsWith("-m.webp"))
    .map((f) => f.replace("-m.webp", ""))
);
---

<Base
  titulo="Proyectos — Ebanistería Montesinos"
  desc="Obra de Ebanistería Montesinos para Christian Louboutin, Harrods Loewe, Andrés Sardá, h10 Waterloo, Cercle Sabadellès, EGISA y particulares."
  ruta="/proyectos"
>
  <main id="principal" class="pagina sc-wrap">
    <div class="titular">
      <p class="eti">Proyectos</p>
      <h1>Proyectos que ya han pasado por el taller.</h1>
      <p>
        Cada pieza salió de la nave de Sabadell montada a escala 1:1 antes de
        viajar a su destino.
      </p>
    </div>

    <ul class="filtros" id="filtros" aria-label="Filtrar por sector">
      <li><button type="button" data-sector="todos" aria-pressed="true">Todos</button></li>
      {sectores.map((s) => (
        <li><button type="button" data-sector={s.id} aria-pressed="false">{s.nombre}</button></li>
      ))}
    </ul>

    <p class="sr" aria-live="polite"><span id="cuenta-obras">{proyectos.length}</span> proyectos</p>

    <div class="rejilla">
      <!-- data-anima: lo observa el IntersectionObserver de Base.astro, el mismo
           que el resto de la web. Va en CADA obra y no en la rejilla, para que
           cada tarjeta entre cuando le toca a ella y no las veinte de golpe. -->
      {proyectos.map((p) => (
        <figure class="obra" data-sector={p.sector} data-anima>
          <div class="obra__media">
            <!-- La rejilla es de 1 columna en móvil y de 3 en escritorio,
                 así que el mismo archivo se pinta a 335 px o a 420 px. Servir
                 los 1800 px del original en un teléfono son ~2,5 MB de
                 galería para nada. Las fotos que lo pedían tienen copia de
                 900 px (`-m`); las que ya venían pequeñas, no, y ahí el
                 srcset se queda con la única que hay. `sizes` es lo que de
                 verdad elige: sin él el navegador supone 100vw y en
                 escritorio bajaría de más. -->
            {!conMovil.has(p.img) ? (
              <img
                src={`/proyectos-web/${p.img}.webp`}
                alt={`Proyecto de Ebanistería Montesinos para ${p.nombre}`}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <img
                src={`/proyectos-web/${p.img}.webp`}
                srcset={`/proyectos-web/${p.img}-m.webp 900w, /proyectos-web/${p.img}.webp 1800w`}
                sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
                alt={`Proyecto de Ebanistería Montesinos para ${p.nombre}`}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <figcaption>
            <h2>{p.nombre}</h2>
            <span class="sect">{nombreSector(p.sector)}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <Pie />
  </main>
</Base>
