---
import Base from "./Base.astro";
import Pie from "../components/Pie.astro";
const { titulo, ruta } = Astro.props;
---
<Base titulo={titulo + " — Montesinos"} desc={titulo + " de la web de Montesinos. Borrador pendiente de completar y validar."} ruta={ruta} noindex={true}>
  <main id="principal" class="pagina sc-wrap legal">
    <h1>{titulo}</h1>
    <p class="legal__borrador"><strong>Borrador para revisión.</strong> Esta información está pendiente de completar con los datos del titular y de validar antes del lanzamiento definitivo.</p>
    <article><slot /></article>
    <Pie />
  </main>
</Base>
<style>
  .legal > h1 { font-size:clamp(2rem,5vw,3.5rem); line-height:1.1; }
  article { max-width:72ch; line-height:1.7; overflow-wrap:anywhere; }
  .legal__borrador { max-width:72ch; border-left:3px solid var(--sc-accent); padding:1rem; background:var(--sc-surface); margin-block:2rem; }
  article :global(h2) { margin-top:2rem; font-size:1.4rem; line-height:1.3; }
  article :global(dt) { font-weight:600; margin-top:1rem; }
  article :global(dd) { margin-left:0; }
  article :global(a) { color:inherit; text-underline-offset:.25em; }
</style>
